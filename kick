-- Training Zone
local TRAINING_ZONES = {"X1.5TrainingZone", "X2TrainingZone", "X3TrainingZone"}
local function getTrainingZonePosition()
    for _, zoneName in ipairs(TRAINING_ZONES) do
        local zone = Workspace:FindFirstChild(zoneName)
        if zone then
            if zone:IsA("Model") then return zone:GetPivot().Position end
            if zone:IsA("BasePart") then return zone.Position end
            if zone:IsA("Folder") then
                for _, child in ipairs(zone:GetChildren()) do
                    if child:IsA("Model") then return child:GetPivot().Position end
                    if child:IsA("BasePart") then return child.Position end
                end
            end
        end
    end
    return nil
end

-- Auto Farm
local function stopAutoFarm()
    autoFarmActive = false; disableRingBoost()
end
local function startAutoFarm()
    if autoFarmActive then return end
    autoFarmActive = true; enableRingBoost()

    task.spawn(function()
        while autoFarmActive do
            if not blastStepActive then clickCenterOfScreen() end
            task.wait(0.3)
        end
    end)

    task.spawn(function()
        while autoFarmActive do
            local filterMode = (#selectedRarities > 0)
            while isDead and autoFarmActive do task.wait(0.1) end
            if not isInTrainingZone then cframeTP(SAFE_POS) end

            local blastButton = nil
            while not blastButton and autoFarmActive do
                local pg = localPlayer:FindFirstChild("PlayerGui")
                if pg then
                    local hud = pg:FindFirstChild("HUD")
                    if hud and hud:IsA("ScreenGui") then
                        local bf = hud:FindFirstChild("BlastFrame")
                        if bf then
                            local bb = bf:FindFirstChild("BlastButton")
                            if bb and bb:IsA("ImageButton") and bb.Visible then blastButton = bb; break end
                        end
                    end
                end
                if not blastButton then task.wait(0.1) end
            end
            if not autoFarmActive then break end

            blastStepActive = true
            realClick(blastButton)
            task.wait(BLAST_CLICK_DELAY)
            clickCenterOfScreen()
            blastStepActive = false

            if filterMode then
                lastRewards = nil
                while not lastRewards and autoFarmActive do
                    if isDead then break end; task.wait(0.2)
                end
                if not autoFarmActive then break end
                if isDead then
                    -- lanjut TP
                else
                    local match = false
                    for _, rwd in ipairs(lastRewards) do
                        if isRaritySelected(rwd.rarity or "") then match = true; break end
                    end
                    if match then
                        local blastVisibleAgain = false
                        while not blastVisibleAgain and autoFarmActive do
                            if not isInTrainingZone then cframeTP(SAFE_POS) end
                            local pg = localPlayer:FindFirstChild("PlayerGui")
                            if pg then
                                local hud = pg:FindFirstChild("HUD")
                                if hud and hud:IsA("ScreenGui") then
                                    local bf = hud:FindFirstChild("BlastFrame")
                                    if bf then
                                        local bb = bf:FindFirstChild("BlastButton")
                                        if bb and bb:IsA("ImageButton") and bb.Visible then blastVisibleAgain = true; break end
                                    end
                                end
                            end
                            if isDead then break end; task.wait(0.2)
                        end
                    else
                        chaseStarted = false
                        while autoFarmActive and not isDead and not chaseStarted do task.wait(0.3) end
                        if not autoFarmActive then break end
                        if not isDead then
                            task.wait(3)
                            local char = localPlayer.Character
                            if char then
                                local hum = char:FindFirstChild("Humanoid")
                                if hum and hum.Health > 0 then hum.Health = 0 end
                            end
                        end
                        task.wait(RESET_WAIT)
                        while isDead and autoFarmActive do task.wait(0.1) end
                    end
                end
            else
                local blastVisibleAgain = false
                while not blastVisibleAgain and autoFarmActive do
                    if not isInTrainingZone then cframeTP(SAFE_POS) end
                    local pg = localPlayer:FindFirstChild("PlayerGui")
                    if pg then
                        local hud = pg:FindFirstChild("HUD")
                        if hud and hud:IsA("ScreenGui") then
                            local bf = hud:FindFirstChild("BlastFrame")
                            if bf then
                                local bb = bf:FindFirstChild("BlastButton")
                                if bb and bb:IsA("ImageButton") and bb.Visible then blastVisibleAgain = true; break end
                            end
                        end
                    end
                    if isDead then break end; task.wait(0.2)
                end
            end
        end
    end)
end

