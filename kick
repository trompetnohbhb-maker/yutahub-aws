-- Blast Reveal
local function onBlastReveal(data)
    if type(data) ~= "table" then return end
    local rewards = data.rewards; if not rewards or #rewards == 0 then return end
    lastRewards = rewards
    if showPredictActive then
        local brainrots, rarities, modifiers = {}, {}, {}
        for _, rwd in ipairs(rewards) do
            local bid = rwd.brainrotId or "???"
            local rarity = rwd.rarity or "???"
            local mod = rwd.modifier; if not mod or mod == "" then mod = "Normal" end
            table.insert(brainrots, bid); table.insert(rarities, rarity); table.insert(modifiers, mod)
        end
        if brainrotLabel then brainrotLabel.Text = "Brainrot: " .. table.concat(brainrots, " | ") end
        if rarityLabel then rarityLabel.Text = "Rarity: " .. table.concat(rarities, " | ") end
        if mutationLabel then mutationLabel.Text = "Mutation: " .. table.concat(modifiers, " | ") end
    end
end
