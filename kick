-- Ring Boost
local ringsSpawnRemote = ReplicatedStorage.Remotes.Rings.RingsSpawn
local ringHitRemote = ReplicatedStorage.Remotes.Rings.RingHit
local function onRingsSpawn(...)
    local args = {...}
    local ringDatas = args[1]
    if type(ringDatas) == "table" then
        local counter = 1
        for _, ringData in ipairs(ringDatas) do
            local ringId = ringData.RingId
            if ringId then
                task.wait(RING_HIT_DELAY)
                pcall(function() firesignal(ringHitRemote.OnClientEvent, counter, ringId) end)
                counter = counter + 1
            end
        end
    end
end
local function enableRingBoost()
    if not ringSpawnConnection then ringSpawnConnection = ringsSpawnRemote.OnClientEvent:Connect(onRingsSpawn) end
end
local function disableRingBoost()
    if ringSpawnConnection then ringSpawnConnection:Disconnect(); ringSpawnConnection = nil end
end

-- Meteor Hit
local function onMeteorSpawn(...)
    if not autoHitMeteorActive then return end
    local args = {...}
    local meteorDatas = args[1]
    if type(meteorDatas) ~= "table" then return end
    local meteors = {}
    for _, meteor in ipairs(meteorDatas) do
        if meteor.MeteorId and meteor.Position then table.insert(meteors, meteor) end
    end
    if #meteors == 0 then return end
    table.sort(meteors, function(a,b) return a.Position.Y < b.Position.Y end)
    for i = 2, #meteors do
        if not autoHitMeteorActive then break end
        local meteor = meteors[i]
        local idNum = tonumber(string.match(meteor.MeteorId, "%d+"))
        if idNum then
            pcall(function() firesignal(meteorHitEvent.OnClientEvent, idNum, meteorHitCounter, 1, nil) end)
            meteorHitCounter = meteorHitCounter + 1
            task.wait(METEOR_HIT_DELAY)
        end
    end
end
local function enableMeteorHit()
    if not meteorSpawnConnection then meteorSpawnConnection = meteorSpawnEvent.OnClientEvent:Connect(onMeteorSpawn) end
end
local function disableMeteorHit()
    if meteorSpawnConnection then meteorSpawnConnection:Disconnect(); meteorSpawnConnection = nil end
    meteorHitCounter = 1
end

